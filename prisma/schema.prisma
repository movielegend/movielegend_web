generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================














// ==========================================
// MODELS
// ==========================================

model Role {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.NVarChar(50)
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("Roles")
}

model User {
  id            Int             @id @default(autoincrement())
  roleId        Int
  role          Role            @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name          String          @db.NVarChar(255)
  email         String          @unique @db.VarChar(255)
  passwordHash  String          @db.VarChar(255)
  phone         String?         @db.VarChar(20)
  isActive      Boolean         @default(true)
  addresses     Address[]
  customer      Customer?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  fileUploads   FileUpload[]
  notifications Notification[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@map("Users")
}

model Address {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String    @db.NVarChar(255)
  phone       String    @db.VarChar(20)
  province    String    @db.NVarChar(100)
  district    String    @db.NVarChar(100)
  ward        String    @db.NVarChar(100)
  addressLine String    @db.NVarChar(500)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("Addresses")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("RefreshTokens")
}

model Customer {
  id        Int       @id @default(autoincrement())
  userId    Int?      @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fullName  String    @db.NVarChar(255)
  phone     String    @unique @db.VarChar(20)
  email     String?   @unique @db.VarChar(255)
  orders    Order[]
  reviews   ProductReview[]
  warranties WarrantyRegistration[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("Customers")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @db.NVarChar(255)
  slug        String     @unique @db.VarChar(255)
  description String?    @db.NVarChar(Max)
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@map("Categories")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @db.NVarChar(255)
  slug        String    @unique @db.VarChar(255)
  logoUrl     String?   @db.NVarChar(1000)
  description String?   @db.NVarChar(Max)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("Brands")
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String    @db.NVarChar(255)
  slug          String    @unique @db.VarChar(255)
  sku           String    @unique @db.VarChar(100)
  description   String?   @db.NVarChar(Max)
  shortDesc     String?   @db.NVarChar(500)
  price         Decimal   @db.Decimal(18, 2)
  originalPrice Decimal?  @db.Decimal(18, 2)
  stockQuantity Int       @default(0)
  isAvailable   Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  categoryId    Int
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brandId       Int
  brand         Brand     @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  images        ProductImage[]
  specifications ProductSpecification[]
  orderItems    OrderItem[]
  serialNumbers SerialNumber[]
  inventoryTx   InventoryTransaction[]
  reviews       ProductReview[]
  seo           ProductSEO?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("Products")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String   @db.NVarChar(1000)
  altText      String?  @db.NVarChar(255)
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("ProductImages")
}

model ProductSpecification {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  specName  String   @db.NVarChar(255)
  specValue String   @db.NVarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("ProductSpecifications")
}

model ProductSEO {
  id              Int      @id @default(autoincrement())
  productId       Int      @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  metaTitle       String?  @db.NVarChar(255)
  metaDescription String?  @db.NVarChar(Max)
  metaKeywords    String?  @db.NVarChar(500)
  canonicalUrl    String?  @db.NVarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("ProductSEO")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerId    Int
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  totalAmount   Decimal     @db.Decimal(18, 2)
  status        String @default("PENDING")
  shippingAddr  String      @db.NVarChar(1000)
  note          String?     @db.NVarChar(Max)
  orderItems    OrderItem[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@map("Orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int
  price     Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("OrderItems")
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   String
  transactionCode String?       @db.VarChar(100)
  amount          Decimal       @db.Decimal(18, 2)
  status          String @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@map("Payments")
}

model SerialNumber {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  serial    String   @unique @db.VarChar(100)
  status    String   @db.VarChar(50) // e.g. AVAILABLE, SOLD, WARRANTY
  warranty  WarrantyRegistration?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("SerialNumbers")
}

model WarrantyRegistration {
  id             Int      @id @default(autoincrement())
  serialNumberId Int      @unique
  serialNumber   SerialNumber @relation(fields: [serialNumberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerId     Int
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseDate   DateTime
  expiryDate     DateTime
  claims         WarrantyClaim[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@map("WarrantyRegistrations")
}

model WarrantyClaim {
  id                     Int                  @id @default(autoincrement())
  warrantyRegistrationId Int
  warrantyRegistration   WarrantyRegistration @relation(fields: [warrantyRegistrationId], references: [id], onDelete: Cascade)
  claimCode              String               @unique @db.VarChar(50)
  problemDescription     String               @db.NVarChar(Max)
  status                 String          @default("PENDING")
  receivedDate           DateTime             @default(now())
  completedDate          DateTime?
  note                   String?              @db.NVarChar(Max)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  @@map("WarrantyClaims")
}

model InventoryTransaction {
  id        Int           @id @default(autoincrement())
  productId Int
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  quantity  Int
  note      String?       @db.NVarChar(500)
  createdBy Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@map("InventoryTransactions")
}

model ProductReview {
  id         Int          @id @default(autoincrement())
  productId  Int
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int          @db.SmallInt
  comment    String?      @db.NVarChar(Max)
  status     String @default("PENDING")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  @@map("ProductReviews")
}

model ContactRequest {
  id        Int           @id @default(autoincrement())
  fullName  String        @db.NVarChar(255)
  phone     String?       @db.VarChar(20)
  email     String?       @db.VarChar(255)
  message   String        @db.NVarChar(Max)
  status    String @default("NEW")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@map("ContactRequests")
}

model FileUpload {
  id         Int      @id @default(autoincrement())
  fileName   String   @db.NVarChar(255)
  fileUrl    String   @db.NVarChar(1000)
  fileType   String   @db.VarChar(50)
  uploadedBy Int?
  user       User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@map("FileUploads")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String   @db.VarChar(50)
  oldValue  String?  @db.NVarChar(Max)
  newValue  String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())

  @@map("AuditLogs")
}

model News {
  id        Int      @id @default(autoincrement())
  title     String   @db.NVarChar(255)
  slug      String   @unique @db.VarChar(255)
  content   String   @db.NVarChar(Max)
  seo       NewsSEO?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("News")
}

model NewsSEO {
  id              Int      @id @default(autoincrement())
  newsId          Int      @unique
  news            News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  metaTitle       String?  @db.NVarChar(255)
  metaDescription String?  @db.NVarChar(Max)
  metaKeywords    String?  @db.NVarChar(500)
  canonicalUrl    String?  @db.NVarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("NewsSEO")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String   @db.NVarChar(255)
  imageUrl  String   @db.NVarChar(1000)
  link      String?  @db.NVarChar(1000)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("Banners")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("Settings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.NVarChar(255)
  message   String   @db.NVarChar(Max)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("Notifications")
}
